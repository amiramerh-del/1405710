{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1405710",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b4d98230-6ba5-43ca-b119-b7cb5d6f352f","database_name": "appnoo" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1379a35394bc44eb8cc1486bbf2a67ea" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
